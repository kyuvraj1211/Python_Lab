# smallest and largest number in the list
num = int(input("Enter number 1: "))
smallest = num
largest = num

for i in range(1, 7):
    num = int(input(f"Enter number {i+1}: "))
    if num < smallest:
        smallest = num
    if num > largest:
        largest = num

print(f"Smallest: {smallest}")
print(f"Largest: {largest}") 
